# Neon Console → 프로젝트 → Connection Details에서 복사. dev/prod 브랜치마다 다름.
DATABASE_URL=

# Neon Console → Auth 설정의 브랜치별 URL. DATABASE_URL과 같은 브랜치로 맞출 것.
NEON_AUTH_BASE_URL=
# 로컬에서 생성. 예: openssl rand -base64 32. PC마다 달라도 됨.
NEON_AUTH_COOKIE_SECRET=
# Neon 관리 API 키 (서명 URL 발급용. Personal 키 가능).
NEON_API_KEY=
# 위 키와 같은 조직의 프로젝트·브랜치 ID. dev/prod 배포마다 해당 값.
NEON_PROJECT_ID=
NEON_BRANCH_ID=
# 기기 연결 암호 봉투용. 예: openssl rand -hex 32. 서버마다 1개, 유출 시 교체.
DEVICE_PACKET_KEY=
# Dodo Payments (과금). 대시보드 Developer → API Keys에서 발급.
DODO_PAYMENTS_API_KEY=
# 모드. test_mode | live_mode (SDK 공식 규약). 키 프리픽스로 판정 안 함 — Dodo 신형 키는 프리픽스가 없다.
DODO_PAYMENTS_ENVIRONMENT=
# 상품 ID는 env에 넣지 않는다 — 서버가 products.list()를 metadata {plan: pro, interval}로 매핑한다.
# 웹훅 서명 검증 키 (whsec_...). 웹훅 등록 후 Developer → Webhooks에서 확인. 웹훅 연동 시 사용.
DODO_PAYMENTS_WEBHOOK_KEY=
# 게이트웨이 내부 호출 표식. 예: openssl rand -hex 32. 노출 시 교체.
INTERNAL_FIRE_AND_FORGET_API_SECRET=
# 브라우저가 API 서버를 부를 주소 (클라이언트에서 요청할 때).
# dev: http://localhost:3005 (ngrok 아님 — ngrok을 넣으면 로그인 쿠키가 깨진다).
# prod: 사이트 URL. baseFetch는 prod에서 prefix를 안 붙이므로 실호출은 상대 경로로 무해.
NEXT_PUBLIC_BASE_URL=
# 서버가 외부에 알릴 자기 주소 (서버에서 URL 끌어올 때). 외부 콜백·웹훅 수신용.
# dev: ngrok URL. prod: 사이트 URL.
# 현재 서버 코드에 소비처 없음. Dodo 웹훅 등 도입 시 사용.
BASE_URL=
# API 서버(3005)가 CORS를 허용할 페이지 origin 목록. 쉼표 구분.
# dev에서 브라우저(3004) → API(3005) 호출에 필요. 미설정 시 dev 기본값 http://localhost:3004.
# prod는 같은 origin이라 불필요. ngrok 주소를 추가해도 로그인 쿠키가 따로라 무의미.
CORS_ALLOWED_ORIGINS=