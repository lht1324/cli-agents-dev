[Unit]
Description=agentgit resident daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/agentgit run
EnvironmentFile=%h/.config/agentgit/env
# 항시 서버가 재시작 때 같이 죽지 않게. 메인이 아니면 손대지 않는다.
KillMode=process
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
